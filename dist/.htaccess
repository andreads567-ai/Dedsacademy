# ==============================================================================
# Deds Academy - Configuração Apache / LiteSpeed (Hostinger hPanel)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forçar conexão segura HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Ignorar arquivos e pastas reais existentes (imagens, uploads, css, js)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Encaminhar todas as outras requisições para a Single Page Application (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# Compressão Gzip / Deflate para alta velocidade de carregamento
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==============================================================================
# Políticas de Cache para Recursos Estáticos (Vite Hashed Assets)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # index.html nunca deve ficar em cache longo para que updates apareçam na hora
  ExpiresByType text/html "access plus 0 seconds"

  # CSS e Javascript possuem hash no nome, então podem ter cache longo
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Imagens e mídias
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ==============================================================================
# Cabeçalhos de Segurança
# ==============================================================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
